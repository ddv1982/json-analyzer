  "curl_executor": {
    "target_decisions": {
      "parse_preview_does_not_execute_network": true,
      "execution_when_added_is_rust_owned_not_frontend_fetch": true,
      "sqlite_persistence": "deferred_not_needed_for_desktop",
      "sensitive_headers_redacted_in_preview": [
        "authorization",
        "proxy-authorization",
        "cookie",
        "set-cookie",
        "x-api-key"
      ],
      "bearer_token_extraction": "report_presence_and_redacted_preview_only"
    },
    "parser_examples": [
      {
        "case": "get_with_accept_header",
        "curl": "curl -H 'Accept: application/json' https://api.example.com/users?limit=2",
        "expected_parse": {
          "method": "GET",
          "url": "https://api.example.com/users?limit=2",
          "headers": [
            {
              "name": "Accept",
              "value": "application/json",
              "redacted": false
            }
          ],
          "body": null,
          "auth": {
            "bearer_token_present": false
          },
          "supported_options": [],
          "warnings": []
        }
      },
      {
        "case": "post_json_with_bearer",
        "curl": "curl -X POST https://api.example.com/users -H 'Authorization: Bearer secret-token' -H 'Content-Type: application/json' --data '{\"name\":\"Alice\"}'",
        "expected_parse": {
          "method": "POST",
          "url": "https://api.example.com/users",
          "headers": [
            {
              "name": "Authorization",
              "value": "Bearer ***",
              "redacted": true
            },
            {
              "name": "Content-Type",
              "value": "application/json",
              "redacted": false
            }
          ],
          "body": "{\"name\":\"Alice\"}",
          "body_kind": "json_string",
          "auth": {
            "bearer_token_present": true,
            "scheme": "Bearer"
          },
          "supported_options": [
            "-X",
            "-H",
            "--data"
          ],
          "warnings": []
        }
      },
      {
        "case": "unsupported_file_upload",
        "curl": "curl -F upload=@secret.txt https://api.example.com/upload",
        "expected_problem": {
          "error_type": "unsupported_file_upload_option",
          "title": "Unsupported curl file upload option",
          "status": 400,
          "detail": "File upload curl options are not supported by the desktop curl parser",
          "invalid_params": [
            {
              "name": "curl",
              "reason": "unsupported file upload option -F"
            }
          ]
        }
      }
    ],
    "guardrail_outcomes": [
      {
        "case": "allow_public_https",
        "request": {
          "method": "GET",
          "url": "https://api.example.com/users"
        },
        "expected_decision": {
          "allowed": true,
          "reason": "public_https_url"
        }
      },
      {
        "case": "deny_localhost",
        "request": {
          "method": "GET",
          "url": "http://localhost:3000/private"
        },
        "expected_decision": {
          "allowed": false,
          "error_type": "curl_guardrail_denied",
          "reason": "localhost_targets_are_blocked_by_default"
        }
      },
      {
        "case": "deny_private_ipv4",
        "request": {
          "method": "GET",
          "url": "http://192.168.1.10/status"
        },
        "expected_decision": {
          "allowed": false,
          "error_type": "curl_guardrail_denied",
          "reason": "private_network_targets_are_blocked_by_default"
        }
      },
      {
        "case": "deny_non_http_scheme",
        "request": {
          "method": "GET",
          "url": "file:///etc/passwd"
        },
        "expected_decision": {
          "allowed": false,
          "error_type": "curl_guardrail_denied",
          "reason": "only_http_and_https_schemes_are_supported"
        }
      },
      {
        "case": "deny_redirect_to_private_network",
        "request": {
          "method": "GET",
          "url": "https://api.example.com/redirect-to-localhost"
        },
        "redirect_target": "http://127.0.0.1/admin",
        "expected_decision": {
          "allowed": false,
          "error_type": "curl_guardrail_denied",
          "reason": "redirect_target_blocked"
        }
      }
    ]
  },
