{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSON Analyzer",
  "version": "0.1.4",
  "identifier": "com.jsonanalyzer.desktop",
  "mainBinaryName": "json-analyzer-app",
  "build": {
    "beforeDevCommand": "pnpm -C frontend run dev",
    "beforeBuildCommand": "scripts/build_frontend_for_tauri.sh",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "JSON Analyzer",
        "width": 1200,
        "height": 880,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-wGWVDgkbf2Les6JnXF5LGBaBWzmIjC92dnOa4+KwKu0='; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "A local-first desktop app for validating, formatting, and exploring JSON data, including duplicate records, field patterns, grouped values, and guarded curl responses.",
    "shortDescription": "Local-first JSON analysis tool",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/doc/json-analyzer/copyright": "debian/copyright",
          "/usr/share/icons/hicolor/32x32/apps/json-analyzer.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/json-analyzer.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/json-analyzer.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/json-analyzer.png": "icons/icon.png",
          "/usr/share/metainfo/com.jsonanalyzer.desktop.metainfo.xml": "appstream/com.jsonanalyzer.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [],
        "files": {
          "/usr/share/licenses/json-analyzer/LICENSE": "../LICENSE",
          "/usr/share/applications/com.jsonanalyzer.desktop.desktop": "linux/com.jsonanalyzer.desktop.desktop",
          "/usr/share/metainfo/com.jsonanalyzer.desktop.metainfo.xml": "appstream/com.jsonanalyzer.desktop.metainfo.xml"
        }
      }
    },
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null
    }
  }
}
